{
  // Ветка Node: код Worker и конвейера, а также проверки, которые тянут окружение
  // Worker. Разрешение модулей — как у Node (`nodenext`): только относительные пути
  // с расширением, без псевдонимов — Node не читает tsconfig и псевдонимов не знает
  // (https://nodejs.org/docs/latest/api/typescript.md).
  //
  // DOM-типы сюда не подключаются намеренно — их наличие маскирует обращения
  // к тому, чего в изоляте нет. Типы Node — потому что Worker включён с
  // `nodejs_compat`, а конвейер работает под Node.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "allowJs": false,
    "types": ["@cloudflare/workers-types", "node"],

    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },

  "include": [
    "src/worker",
    "src/shared",
    "src/pipeline",
    "tests/contract",
    "tests/unit/schedule-select.test.ts",
    "tests/unit/schedule-skip.test.ts",
    "tests/unit/document-naming.test.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
