{
  // Cloudflare Workers: изолят V8 без файловой системы и без Node-глобалей.
  // DOM-типы сюда не подключаются намеренно — их наличие маскирует обращения
  // к тому, чего в изоляте нет.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,
    // "bun-types/test" — только объявление модуля `bun:test`, без глобальных
    // Node/DOM-подобных типов из bun-types/globals.d.ts, которые
    // конфликтовали бы с типами Workers.
    "types": ["@cloudflare/workers-types", "bun-types/test"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src/worker", "src/shared", "tests/contract", "tests/unit/schedule-select.test.ts"],
  "exclude": ["dist", "node_modules"]
}
