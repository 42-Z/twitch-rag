{
  // Cloudflare Workers: изолят V8 без файловой системы и без Node-глобалей.
  // DOM-типы сюда не подключаются намеренно — их наличие маскирует обращения
  // к тому, чего в изоляте нет.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,
    "types": ["@cloudflare/workers-types"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src/worker", "src/shared"],
  "exclude": ["dist", "node_modules"]
}
