{
  // Ветка сборщика: страница (собирает Vite) и проверки, которые исполняет Vitest.
  // Код Worker и конвейера проверяется отдельно — tsconfig.worker.json.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node", "react", "vite/client"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  "include": [
    "src/ui",
    "src/shared",
    "src/components",
    "src/lib",
    "tests/unit",
    "tests/integration",
    "tests/e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "playwright.config.ts"
  ],
  // tests/contract и тесты, тянущие окружение Worker, типизируются вместе с
  // ним (tsconfig.worker.json) — там нет DOM-типов, конфликтующих с типами
  // Workers.
  "exclude": [
    "dist",
    "node_modules",
    "tests/contract",
    "tests/unit/schedule-select.test.ts",
    "tests/unit/schedule-skip.test.ts",
    "tests/unit/document-naming.test.ts"
  ]
}
