# Образец локального окружения. Скопировать в .env и заполнить.
# На сервере эти же значения ставятся как секреты: wrangler secret put <ИМЯ>
# Исключение — переменные BUN_PUBLIC_*: они попадают в сборку интерфейса
# и видны в браузере, поэтому там допустимы только публичные значения.

# Модели: распознавание речи, составление документа, эмбеддинги.
# Один ключ на весь конвейер, запросы уходят на https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Векторная база: разделы документов
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Реестр разобранного и настройки канала
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Хранилище документов трансляций
UPSTASH_BLOB_TOKEN=

# Бокс: скачивание записи и нарезка аудио — то, что невозможно в Worker
UPSTASH_BOX_API_KEY=
UPSTASH_BOX_ID=

# Приложение Twitch: список записей канала через Helix
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Общий секрет между боксом и Worker: заголовок X-Ingest-Secret
INGEST_SECRET=

# Токен владельца: добавление и удаление записей, смена канала
APP_ADMIN_TOKEN=

# Доступ бокса к R2 по протоколу S3 — привязкой Worker снаружи не воспользоваться
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=twitch-audio

# Публичные значения для интерфейса: страница читает реестр напрямую,
# минуя Worker. Токен только на чтение — документация Upstash прямо
# допускает его раскрытие в веб-клиентах.
BUN_PUBLIC_REGISTRY_URL=
BUN_PUBLIC_REGISTRY_READONLY_TOKEN=
