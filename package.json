{
  "name": "twitch-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:ui": "vite build --watch",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tests/worker/tsconfig.json",
    "build:pipeline": "esbuild src/pipeline/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=pipeline.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@upstash/blob": "^0.0.5",
    "@upstash/box": "^0.7.5",
    "@upstash/redis": "^1.38.4",
    "@upstash/vector": "^1.2.3",
    "agents": "^0.23.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1",
    "openai": "^7.15.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@msw/cloudflare": "^0.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "description": "База знаний по трансляциям Twitch для ИИ-ассистентов",
  "engines": {
    "node": ">=24.12"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "core-js-pure": false,
    "msw": false
  }
}
